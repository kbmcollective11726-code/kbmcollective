# Copy to .env and fill with your Supabase project values.
# Use the SAME Supabase project as the native app (same URL and anon key).
# Get from: Supabase Dashboard → Your Project → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: deployed Next.js “live wall” app (same Supabase as above). Enables “Live wall” links per event.
# Must match EXPO_PUBLIC_LIVE_WALL_URL from the Expo app — same string, different variable name (Vite only reads VITE_*).
# VITE_LIVE_WALL_URL=https://your-live-wall.vercel.app
