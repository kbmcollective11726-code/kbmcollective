# Copy to .env and fill with your Supabase project values.
# Use the SAME Supabase project as the native app (same URL and anon key).
# Get from: Supabase Dashboard → Your Project → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public registration + delegate/vendor portal (connect.kbmcollective.org).
# VITE_PUBLIC_PORTAL_URL=https://connect.kbmcollective.org

# Optional: deployed Next.js “live wall” app (same Supabase as above).
# VITE_LIVE_WALL_URL=https://your-live-wall.vercel.app
